---
interface Props {
  href: string;
  label: string;
}
const { href, label } = Astro.props;
---

<a href={href} class="back">
  <svg
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="rtl-flip"><path d="m15 18-6-6 6-6"></path></svg
  >
  {label}
</a>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: calc(14px * var(--scale));
    color: var(--ink-2);
    text-decoration: none;
    padding: 18px 2px 2px;
    min-height: 44px; /* 44px minimum touch target */
  }
  .back:hover {
    color: var(--ink);
  }
  .back:focus-visible {
    outline: 2px solid var(--ink-3);
    outline-offset: 2px;
    border-radius: 6px;
  }
  :global([dir='rtl']) .rtl-flip {
    transform: scaleX(-1);
  }
</style>
