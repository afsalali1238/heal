---
import type { MotionAsset } from '../../lib/motion/motion-registry';

interface Props {
  asset: MotionAsset;
  title: string;
}
const { asset, title } = Astro.props;
---

<section class="motion" data-motion-player aria-labelledby="motion-title">
  <div class="prototype">PROTOTYPE — NOT CLINICALLY REVIEWED</div>
  <h2 id="motion-title">{title} movement review</h2>
  <video data-video preload="metadata" playsinline poster={asset.posterPath}>
    <source src={asset.motionPath} type="video/mp4" />
    The movement preview cannot play in this browser. The poster and written instructions remain available.
  </video>
  <div class="controls" aria-label="Movement controls">
    <button type="button" data-play>Play</button>
    <button type="button" data-pause disabled>Pause</button>
    <button type="button" data-replay>Replay</button>
    <button type="button" data-reset>Reset</button>
  </div>
  <p data-status role="status">Poster shown. Press Play to view the prototype.</p>
</section>

<script>
  const root = document.querySelector<HTMLElement>('[data-motion-player]');
  if (root) {
    const video = root.querySelector<HTMLVideoElement>('[data-video]')!;
    const play = root.querySelector<HTMLButtonElement>('[data-play]')!;
    const pause = root.querySelector<HTMLButtonElement>('[data-pause]')!;
    const replay = root.querySelector<HTMLButtonElement>('[data-replay]')!;
    const reset = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const sync = () => {
      play.disabled = !video.paused;
      pause.disabled = video.paused;
    };
    const doPlay = async () => {
      try {
        await video.play();
        status.textContent = 'Prototype movement playing.';
      } catch {
        status.textContent =
          'The prototype movement could not be played. The poster remains available.';
      }
      sync();
    };
    play.addEventListener('click', doPlay);
    pause.addEventListener('click', () => {
      video.pause();
      status.textContent = 'Prototype movement paused.';
      sync();
    });
    replay.addEventListener('click', () => {
      video.currentTime = 0;
      void doPlay();
    });
    reset.addEventListener('click', () => {
      video.pause();
      video.currentTime = 0;
      video.load();
      status.textContent = 'Poster shown. Press Play to view the prototype.';
      sync();
    });
    video.addEventListener('ended', () => {
      status.textContent = 'Prototype movement finished. Press Replay to watch again.';
      sync();
    });
    video.addEventListener('error', () => {
      status.textContent = 'The prototype movement failed to load. The poster remains available.';
      sync();
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && !video.paused) {
        video.pause();
        status.textContent = 'Prototype movement paused because the page is hidden.';
        sync();
      }
    });
    if ('IntersectionObserver' in window)
      new IntersectionObserver(
        (entries) => {
          if (!entries[0]?.isIntersecting && !video.paused) {
            video.pause();
            status.textContent = 'Prototype movement paused because it left the screen.';
            sync();
          }
        },
        { threshold: 0.15 }
      ).observe(root);
    if (reducedMotion)
      status.textContent =
        'Reduced motion is enabled. The poster is shown until you explicitly press Play.';
    sync();
  }
</script>

<style>
  .motion {
    border: 2px solid #b45309;
    border-radius: 16px;
    padding: 18px;
    background: var(--surface);
    display: grid;
    gap: 14px;
  }
  .prototype {
    background: #fff7ed;
    color: #7c2d12;
    padding: 9px 12px;
    font-weight: 800;
    text-align: center;
  }
  .motion h2 {
    font: 700 calc(24px * var(--scale)) var(--f-display);
    margin: 0;
  }
  .motion video {
    display: block;
    width: 100%;
    aspect-ratio: 1/1;
    max-height: 560px;
    object-fit: contain;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .controls button {
    min-height: 44px;
    padding: 9px 16px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--surface-2);
    color: var(--ink);
    font: 600 calc(15px * var(--scale)) var(--f-display);
    cursor: pointer;
  }
  .controls button:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .motion p {
    margin: 0;
    color: var(--ink-2);
  }
</style>
