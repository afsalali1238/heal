---
/**
 * Sticky top bar with the text-size control. MODULES.md M07.
 *
 * The control is the one piece of interactivity on a content page, and it earns
 * it: DESIGN-SYSTEM.md sets the base size at 17px because "the reader is older
 * and often magnifying", and browser zoom reflows the whole layout while this
 * scales only type.
 *
 * Three fixes from the earlier version:
 *
 * 1. The button was 34px tall, under the 44px floor the conventions set for
 *    patients who may be in pain, one-handed, or elderly.
 * 2. The label said "Text Size" at every setting, so a screen-reader user
 *    cycling 1 → 1.15 → 1.3 got no confirmation that anything had happened. The
 *    current level is now in the accessible name, and changes are announced.
 * 3. Sizes were hardcoded px, bypassing the --fs-* tokens.
 *
 * The stored preference is applied by a blocking inline script in Base.astro's
 * <head>, not here. Applying it from this deferred script meant the page painted
 * at 1 and then jumped — and with <ClientRouter /> removed, every navigation is a
 * full load, so that jump would happen on every page rather than only the first.
 */
---

<div class="top">
  <div class="top-in">
    <a href="/" class="brandmark"><span>Physiotherapy</span>Patient Library</a>
    <div class="top-actions">
      <button
        type="button"
        class="tbtn"
        id="searchTriggerBtn"
        aria-label="Search handbook by body area or exercise"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="11" cy="11" r="8"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="tbtn__label">Search</span>
      </button>
      <button
        type="button"
        class="tbtn"
        id="textSizeBtn"
        aria-label="Text size, normal. Activate to increase."
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M4 7V5h9v2"></path><path d="M8.5 5v14"></path><path d="M6 19h5"></path>
          <path d="M14 12h6"></path><path d="M17 9v6"></path>
        </svg>
        <span class="tbtn__label" id="textSizeLabel">Text size</span>
      </button>
    </div>
  </div>
  <p class="visually-hidden" id="textSizeStatus" role="status" aria-live="polite"></p>
</div>

<style>
  .top {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--brand);
    color: var(--brand-ink);
  }

  .top-in {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 8px var(--pad);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .brandmark {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: calc(var(--fs-small) * var(--scale));
    margin: 0;
    flex: 1;
    min-width: 0;
    line-height: 1.2;
    text-decoration: none;
    color: inherit;
  }

  .top-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .brandmark span {
    display: block;
    font-weight: 500;
    font-size: calc(var(--fs-tiny) * var(--scale));
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .tbtn {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: calc(var(--fs-label) * var(--scale));
    background: transparent;
    color: inherit;
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 0 14px;
    cursor: pointer;
    white-space: nowrap;
    /* 44px floor — see the note above. */
    min-height: 44px;
    min-width: 44px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    opacity: 0.85;
  }

  .tbtn svg {
    width: 17px;
    height: 17px;
    flex: none;
  }

  .tbtn:hover {
    opacity: 1;
  }

  .tbtn:focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 3px;
    opacity: 1;
  }

  /* At 1.3 scale on a 360px viewport the word would push the brandmark out. */
  @media (max-width: 400px) {
    .tbtn__label {
      display: none;
    }
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>

<script>
  (() => {
    const searchBtn = document.getElementById('searchTriggerBtn');
    searchBtn?.addEventListener('click', () => {
      window.dispatchEvent(new CustomEvent('open-handbook-search'));
    });

    const btn = document.getElementById('textSizeBtn');
    const label = document.getElementById('textSizeLabel');
    const status = document.getElementById('textSizeStatus');
    if (!btn || !label || !status) return;

    const STEPS = [
      { scale: '1', short: 'Text size', name: 'normal' },
      { scale: '1.15', short: 'Larger', name: 'larger' },
      { scale: '1.3', short: 'Largest', name: 'largest' },
    ] as const;

    const KEY = 'physio-scale';

    function read(): number {
      try {
        const found = STEPS.findIndex((s) => s.scale === localStorage.getItem(KEY));
        return found === -1 ? 0 : found;
      } catch {
        return 0;
      }
    }

    let index = read();

    function paint(announce: boolean): void {
      const step = STEPS[index];
      document.documentElement.style.setProperty('--scale', step.scale);
      label!.textContent = step.short;
      const next = STEPS[(index + 1) % STEPS.length];
      btn!.setAttribute('aria-label', `Text size, ${step.name}. Activate to set ${next.name}.`);
      if (announce) status!.textContent = `Text size ${step.name}.`;
    }

    paint(false);

    btn.addEventListener('click', () => {
      index = (index + 1) % STEPS.length;
      try {
        localStorage.setItem(KEY, STEPS[index].scale);
      } catch {
        /* Private browsing. The setting still applies for this page. */
      }
      paint(true);
    });
  })();
</script>
