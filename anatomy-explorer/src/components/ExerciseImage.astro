---
/**
 * The demonstration image for one item. MODULES.md M08.
 *
 * IMAGE-PIPELINE.md's delivery contract is one line: **only `approved` ships.**
 * That was previously enforced nowhere — the component rendered whatever file it
 * found on disk, whatever the sheet said about it.
 *
 * That is not a theoretical gap. IMAGE-TEST-VERDICT.md records `ex-neck-02.jpg`
 * as "FAIL — worst of the set": the head sits slightly *forward* of the
 * shoulders, which is the posture the chin tuck exists to correct, so the picture
 * shows the opposite of the instruction printed beside it. A patient who reads
 * the picture instead of the words — which is most patients, that is why the
 * picture is there — would practise the wrong thing. The nine rejected renders
 * are still sitting in src/assets/images/.
 *
 * So an image now has to be signed off to reach a patient. Anything short of
 * `approved` renders as a labelled empty slot: the instructions are complete
 * prose on their own (CONTENT-SCHEMA.md requires start position, movement,
 * direction/return and safety), so text-only is degraded, not unsafe.
 *
 * `preview` inverts this. The preview route exists for the physiotherapist to
 * review unapproved work, so there it renders with the status shown.
 */
import { Image } from 'astro:assets';
import { pickFigure } from '../lib/images';

interface Props {
  imageId?: string;
  alt?: string;
  /** From the sheet. Undefined means the clinician has not recorded a status. */
  imageStatus?: 'pending' | 'generated' | 'approved';
  eager?: boolean;
  /** Clinician review mode: show unapproved images, flagged. */
  preview?: boolean;
}

const { imageId, alt, imageStatus, eager = false, preview = false } = Astro.props;

const approved = imageStatus === 'approved';
const mayRender = Boolean(imageId) && (approved || preview);

/**
 * Non-negotiable #5: alt text describes the position. An image with no usable
 * alt text is not renderable — a screen-reader user would get a silent gap where
 * the demonstration should be. `check:compliance` fails the build for this, so
 * reaching here means the gate was bypassed; fall back to the slot rather than
 * emit `alt=""` on clinical content.
 */
const usableAlt = typeof alt === 'string' && alt.trim().length > 0 ? alt.trim() : null;

/**
 * The file lookup is deliberately separate from the permission to render.
 *
 * **Fixed on port.** Previously `resolved` was `null` whenever `mayRender` was
 * false, and the slot text checked `!resolved` *before* it checked approval —
 * so every unapproved image, including ones whose file is sitting right there
 * on disk, told the patient "Image file missing". That reads as a broken
 * website rather than as work in progress, and it is the wrong fact.
 */
/**
 * A 1×1 file is a build placeholder, not a clinical illustration, and a generated
 * schematic is not a photograph either — so the lookup returns both the image and
 * what kind it is. `pickFigure` prefers a real file; the schematic only appears where
 * there is nothing real, which is the whole reason it exists.
 */
const picked = imageId ? await pickFigure(imageId) : null;
const mayShow = mayRender && Boolean(usableAlt) && Boolean(picked);
const resolved = mayShow ? picked!.image : null;
const schematic = mayShow && picked!.kind === 'schematic';
// An SVG with CSS keyframes must not go through the image optimiser: rasterising it
// bakes one frame and silently kills the movement it was drawn to show.
const isSvg = schematic || typeof resolved?.src === 'string';

/**
 * Patient-facing wording, in the order the reasons actually apply. None of
 * these is an error the patient can do anything about, so none of them is
 * phrased as one — the instructions below are complete prose on their own.
 */
const slotReason = !imageId
  ? 'No picture for this one yet'
  : !usableAlt
    ? 'Picture held back — it has no description yet'
    : !approved && !preview
      ? 'Picture waiting to be checked by your physiotherapist'
      : !picked
        ? 'Picture not added yet'
        : 'Picture awaiting approval';
---

{
  resolved ? (
    <figure class="shot">
      {schematic || isSvg ? (
        <img
          src={resolved.src}
          alt={usableAlt}
          width={resolved.width}
          height={resolved.height}
          loading={eager ? 'eager' : 'lazy'}
          decoding={eager ? 'sync' : 'async'}
          class="shot__img"
        />
      ) : (
        <Image
          src={resolved}
          alt={usableAlt!}
          widths={[400, 800, 1200]}
          sizes="(min-width: 780px) 740px, 100vw"
          format="webp"
          loading={eager ? 'eager' : 'lazy'}
          decoding={eager ? 'sync' : 'async'}
          class="shot__img"
        />
      )}
      {preview && !approved && (
        <figcaption class="shot__flag">Not approved — {imageStatus ?? 'no status'}</figcaption>
      )}
      {schematic && (
        <figcaption class="shot__flag shot__flag--soft">Schematic · not a photograph</figcaption>
      )}
    </figure>
  ) : (
    <div class="slot" role="img" aria-label={usableAlt ?? slotReason}>
      <span>{slotReason}</span>
      <small>Follow the written steps below.</small>
    </div>
  )
}

<style>
  .shot {
    margin: 0;
    position: relative;
  }

  .shot__img {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    /*
     * `contain`, never `cover`. A cropped clinical photograph can cut off the
     * hand placement or the end range that the exercise is about. Letterboxing
     * against the slot colour is the lesser cost.
     */
    object-fit: contain;
    background-color: var(--slot);
    display: block;
    border-radius: var(--r-inner);
  }

  .shot__flag--soft {
    background: var(--slot, #f3f4f6);
    color: var(--ink-3, #6b7280);
  }

  .shot__flag {
    position: absolute;
    inset-block-start: 8px;
    inset-inline-start: 8px;
    background: var(--warn-bg);
    color: var(--warn);
    font-family: var(--f-display);
    font-weight: 600;
    font-size: calc(var(--fs-label) * var(--scale));
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: 999px;
  }

  .slot {
    width: 100%;
    min-height: 180px;
    background-color: var(--slot);
    border: 1px dashed var(--slot-line);
    border-radius: var(--r-inner);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 16px;
    text-align: center;
    color: var(--ink-3);
  }

  .slot span {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: calc(var(--fs-meta) * var(--scale));
  }

  .slot small {
    font-size: calc(var(--fs-micro) * var(--scale));
  }

  @media (min-width: 780px) {
    .slot {
      min-height: 220px;
    }
  }
</style>
