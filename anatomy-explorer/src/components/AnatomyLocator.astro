---
/**
 * The body-area locator.
 *
 * ── What changed, and why ──────────────────────────────────────────────────
 * The previous version dead-ended: it contained exactly two links — home and
 * the skip link — so the home page's primary call to action led to a screen a
 * patient could only back out of. Region→area resolution, the mechanism the
 * whole merge exists for, was never wired.
 *
 * Three structural decisions here:
 *
 * 1. **Every destination is a real `<a href>` rendered on the server.** No
 *    client-side routing, no JS-built URLs. PRD §10 puts JS "near zero on
 *    content pages", and patients open this on old phones on slow connections.
 *    With JS disabled the page still works end to end: the safety notice shows,
 *    the area list shows, the links go where they say.
 *
 * 2. **The safety check is a gate (A-007), implemented as progressive
 *    enhancement.** JS hides the area chooser until the patient answers, and
 *    "I'm not sure" stops rather than routes onward — the decision says
 *    explicitly: no skip, no "I'm not sure" that routes onward. Without JS the
 *    triggers are still shown, above the chooser, as a static notice. A gate
 *    that only exists in JS would be no gate at all for the patient whose
 *    browser failed to run it.
 *
 * 3. **The SVG map is presentational; the list is the accessible control.**
 *    `role="button" tabindex="0"` on an SVG `<g>` focuses inconsistently across
 *    browsers and assistive tech, and duplicating every region as both a map
 *    shape and a list button creates two tab stops announcing the same thing.
 *    So the map is `aria-hidden` and pointer-driven, and the always-visible
 *    list beside it carries the semantics. Nothing is reachable only by map.
 *
 * Regions come from `body-regions.ts`, which derives them from published
 * content (A-005) and from the shared joint table (A-006). This component
 * hardcodes no anatomy.
 */
import { getBodyRegions, getAreaChoices, type BodyView } from '../data/anatomy/body-regions';
import { SAFETY_CHECK_OPTIONS, SAFETY_RULES } from '../data/anatomy/safety-rules';
import { VIEWBOX, SILHOUETTE, DETAIL } from '../lib/anatomy/geometry/skeleton';

const [regions, areaChoices] = await Promise.all([getBodyRegions(), getAreaChoices()]);

const views: BodyView[] = ['front', 'back'];
const regionsByView = Object.fromEntries(
  views.map((view) => [view, regions.filter((r) => r.views.includes(view))])
) as Record<BodyView, typeof regions>;

// The eight approved triggers, plus "I'm not sure". "None of these" is pulled
// out and rendered as the primary action rather than as one radio among nine —
// it is the answer almost everyone gives, and burying it makes the gate feel
// like an accusation.
const triggers = SAFETY_CHECK_OPTIONS.filter((o) => {
  if (o.id === 'none' || o.id === 'unsure') return false;
  const rule = SAFETY_RULES.find((r) => r.id === o.id);
  return rule?.status === 'published';
});
const unsure = SAFETY_CHECK_OPTIONS.find((o) => o.id === 'unsure');
---

<div class="locator" data-locator>
  <!-- ── Safety gate ─────────────────────────────────────────────────── -->
  <section class="gate" data-gate aria-labelledby="gate-title">
    <p class="step">Before you start</p>
    <h1 id="gate-title">Do any of these apply to you right now?</h1>
    <p class="gate-lede">
      These need a person, not a web page. If any of them describe you, do not use the exercises
      today.
    </p>

    <ul class="triggers">
      {
        triggers.map((t) => (
          <li>
            <button type="button" class="trigger" data-stop={t.id}>
              {t.label}
            </button>
          </li>
        ))
      }
      {
        unsure && (
          <li>
            <button type="button" class="trigger trigger-unsure" data-stop={unsure.id}>
              {unsure.label}
            </button>
          </li>
        )
      }
    </ul>

    <button type="button" class="gate-clear" data-gate-clear>
      None of these apply — continue
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
      >
    </button>
  </section>

  <!-- ── Stop screen ─────────────────────────────────────────────────── -->
  <section class="stop" data-stop-screen hidden aria-labelledby="stop-title" tabindex="-1">
    <p class="step step-stop">Stop</p>
    <h1 id="stop-title" data-stop-title>This needs urgent medical assessment.</h1>
    <p data-stop-message></p>
    <div class="stop-actions">
      <button type="button" class="button-secondary" data-stop-back>Go back</button>
    </div>
    <p class="stop-draft">
      This wording is awaiting physiotherapist review. It is shown because stopping is the safe
      default, not because it has been signed off.
    </p>
  </section>

  <!-- ── Area chooser ────────────────────────────────────────────────── -->
  <section class="chooser" data-chooser aria-labelledby="chooser-title" tabindex="-1">
    <p class="step">Choose an area</p>
    <h1 id="chooser-title">Where did your physiotherapist point?</h1>
    <p class="chooser-lede">
      Choose from the Front or Back view, or use the plain list below. Every area link is a
      keyboard-accessible route to the same destination.
    </p>

    {
      regions.length === 0 ? (
        <p class="empty">
          No body areas have been published yet. Your physiotherapist adds them as each one is
          reviewed.
        </p>
      ) : (
        <div class="chooser-grid">
          <div class="map-column">
            <div class="view-toggle" role="group" aria-label="Body view">
              {views.map((view, i) => (
                <button
                  type="button"
                  class:list={['toggle-button', { 'is-active': i === 0 }]}
                  data-view={view}
                  aria-pressed={i === 0 ? 'true' : 'false'}
                >
                  {view === 'front' ? 'Front' : 'Back'}
                </button>
              ))}
            </div>

            {views.map((view, i) => (
              <svg
                class="body-map"
                data-map-view={view}
                viewBox={VIEWBOX}
                aria-hidden="true"
                focusable="false"
                {...(i !== 0 ? { hidden: '' } : {})}
              >
                <g class="silhouette">
                  {SILHOUETTE.filled.map((d) => (
                    <path d={d} />
                  ))}
                  {SILHOUETTE.strokes.map((s) => (
                    <path d={s.d} stroke-width={s.w} class="stroke-part" />
                  ))}
                </g>
                <g class="detail">
                  {DETAIL[view].map((d) => (
                    <path d={d} />
                  ))}
                </g>
                <g class="hotspots">
                  {regionsByView[view].map((region) => (
                    <a
                      class="hotspot"
                      href={`/area/${region.areaId}/`}
                      data-region={region.areaId}
                      tabindex="-1"
                    >
                      {region.shapes.map((s) => (
                        <path d={s.d} stroke-width={s.w} />
                      ))}
                    </a>
                  ))}
                </g>
              </svg>
            ))}

            <p class="map-note">Every area is in the list as well.</p>
          </div>

          <div class="list-column">
            <h2 class="list-title">Body areas</h2>
            <ul class="area-list">
              {areaChoices.map((choice, i) => (
                <li>
                  <a
                    class="area-link"
                    href={`/area/${choice.areaId}/`}
                    data-area-link={choice.areaId}
                  >
                    <span class="area-num" aria-hidden="true">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="area-name">{choice.name}</span>
                    <span class="area-meta">
                      {choice.routes
                        .map(
                          (r) =>
                            `${r.count} ${r.section === 'stretching' ? 'stretching' : 'exercise'}`
                        )
                        .join(' · ')}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }
  </section>

  <p class="sr-only" aria-live="polite" data-live></p>
</div>

<style>
  .locator {
    display: grid;
    gap: 0;
    padding-bottom: 8px;
  }

  .step {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: calc(11.5px * var(--scale));
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 8px;
  }
  .step-stop {
    color: var(--warn);
  }

  .locator h1 {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: calc(clamp(25px, 6vw, 33px) * var(--scale));
    line-height: 1.12;
    letter-spacing: -0.018em;
    margin: 0 0 10px;
    text-wrap: balance;
  }
  .gate-lede,
  .chooser-lede {
    margin: 0 0 20px;
    color: var(--ink-2);
    max-width: 54ch;
    font-size: calc(16.5px * var(--scale));
  }

  /* ── gate ── */
  .gate {
    padding: 20px 0 8px;
  }
  .triggers {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    display: grid;
    gap: 7px;
  }
  .trigger {
    width: 100%;
    text-align: start;
    cursor: pointer;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    border-radius: 11px;
    padding: 13px 15px;
    min-height: 48px;
    font-size: calc(15.5px * var(--scale));
    line-height: 1.4;
  }
  .trigger:hover {
    border-color: var(--warn);
    color: var(--warn);
  }
  .trigger:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }
  .trigger-unsure {
    border-style: dashed;
    color: var(--ink-2);
  }

  .gate-clear {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    cursor: pointer;
    min-height: 56px;
    background: var(--brand);
    color: var(--brand-ink);
    border: 1px solid var(--brand);
    border-radius: 12px;
    padding: 14px 20px;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: calc(17px * var(--scale));
    line-height: 1.25;
    text-wrap: balance;
  }
  .gate-clear:hover {
    filter: brightness(0.95);
  }
  .gate-clear:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  .gate-clear svg {
    width: 20px;
    height: 20px;
  }

  /* ── stop ── */
  .stop {
    padding: 22px 20px;
    margin: 20px 0;
    background: var(--warn-bg);
    color: var(--warn);
    border: 1px solid currentColor;
    border-radius: var(--r, 14px);
  }
  .stop h1 {
    color: inherit;
  }
  .stop p {
    margin: 0 0 14px;
    font-size: calc(16.5px * var(--scale));
    line-height: 1.5;
    max-width: 54ch;
  }
  .stop-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .button-secondary {
    cursor: pointer;
    min-height: 48px;
    padding: 12px 18px;
    background: transparent;
    color: inherit;
    border: 1px solid currentColor;
    border-radius: 11px;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: calc(15.5px * var(--scale));
  }
  .button-secondary:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 2px;
  }
  .stop-draft {
    margin: 16px 0 0;
    font-size: calc(12.5px * var(--scale));
    opacity: 0.85;
    line-height: 1.5;
  }

  /* ── chooser ── */
  .chooser {
    padding: 20px 0 0;
  }
  .chooser:focus,
  .stop:focus {
    outline: none;
  }
  .chooser-grid {
    display: grid;
    gap: 22px;
  }
  @media (min-width: 720px) {
    .chooser-grid {
      grid-template-columns: 260px 1fr;
      gap: 32px;
      align-items: start;
    }
  }

  .view-toggle {
    display: inline-flex;
    gap: 2px;
    padding: 3px;
    margin-bottom: 10px;
    background: var(--surface-2);
    border-radius: 10px;
  }
  .toggle-button {
    cursor: pointer;
    min-height: 44px;
    padding: 8px 18px;
    background: transparent;
    color: var(--ink-2);
    border: 0;
    border-radius: 8px;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: calc(14px * var(--scale));
  }
  .toggle-button.is-active {
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }
  .toggle-button:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }

  .body-map {
    width: 100%;
    max-width: 260px;
    height: auto;
    display: block;
    margin-inline: auto;
  }
  /* `display: block` above out-specifies the UA's `[hidden] { display: none }`,
   so without this the front and back figures both render, stacked. */
  .body-map[hidden] {
    display: none;
  }
  /* The body must read as a body at a glance. `--surface-2` on `--ground` is a
   two-percent difference in luminance — on a phone in daylight the figure
   disappeared and the hotspots looked like free-floating blobs. */
  .silhouette path {
    fill: var(--line);
    stroke: none;
  }
  .silhouette .stroke-part {
    stroke: var(--line);
    fill: none;
    stroke-linecap: round;
  }
  .detail path {
    fill: none;
    stroke: var(--ink-3);
    stroke-width: 1.5;
    stroke-linecap: round;
    opacity: 0.55;
  }

  .hotspot path {
    fill: none;
    stroke: var(--brand);
    stroke-linecap: round;
    opacity: 0.34;
    transition: opacity 0.12s ease;
  }
  .hotspot:hover path,
  .hotspot.is-active path {
    opacity: 0.85;
  }

  .map-note {
    margin: 10px 0 0;
    color: var(--ink-3);
    font-size: calc(12.5px * var(--scale));
  }

  .list-title {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: calc(11.5px * var(--scale));
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 10px;
  }
  .area-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 7px;
  }
  .area-link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) minmax(0, auto);
    gap: 12px;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 11px;
    padding: 13px 15px;
    min-height: 56px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.12s ease;
  }
  .area-link:hover {
    border-color: var(--brand);
  }
  .area-link:focus-visible {
    outline: 3px solid var(--brand);
    outline-offset: 2px;
  }
  .area-num {
    font-family: var(--f-mono);
    font-size: calc(12px * var(--scale));
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .area-name {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: calc(17px * var(--scale));
  }
  .area-meta {
    font-family: var(--f-mono);
    font-size: calc(11.5px * var(--scale));
    color: var(--ink-3);
    text-align: end;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .empty {
    margin: 8px 0 0;
    padding: 16px 18px;
    border: 1px dashed var(--line);
    border-radius: 12px;
    color: var(--ink-2);
    font-size: calc(15.5px * var(--scale));
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .hotspot path,
    .area-link {
      transition: none;
    }
  }
</style>

<script>
  import { findSafetyRule } from '../data/anatomy/safety-rules';

  const root = document.querySelector<HTMLElement>('[data-locator]');
  if (root) {
    const gate = root.querySelector<HTMLElement>('[data-gate]')!;
    const stop = root.querySelector<HTMLElement>('[data-stop-screen]')!;
    const chooser = root.querySelector<HTMLElement>('[data-chooser]')!;
    const stopTitle = root.querySelector<HTMLElement>('[data-stop-title]')!;
    const stopMessage = root.querySelector<HTMLElement>('[data-stop-message]')!;
    const live = root.querySelector<HTMLElement>('[data-live]')!;

    /**
     * The gate only becomes a gate once this script runs. Until then the page
     * has rendered every section, so a patient without JS still sees the
     * triggers and can still reach their exercises.
     */
    chooser.hidden = true;

    const show = (screen: HTMLElement, announcement: string) => {
      for (const s of [gate, stop, chooser]) s.hidden = s !== screen;
      live.textContent = announcement;
      screen.focus?.();
    };

    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-stop]')) {
      button.addEventListener('click', () => {
        const id = button.dataset.stop!;
        const rule = findSafetyRule(id);
        if (rule) {
          stopTitle.textContent = rule.title;
          stopMessage.textContent = rule.message;
        } else {
          // "I'm not sure" — A-007: this must not route onward. Not knowing is
          // treated as a reason to ask a person, not as a reason to proceed.
          stopTitle.textContent = 'Check with the clinic before you start.';
          stopMessage.textContent =
            'If you are not sure whether one of these applies to you, contact the clinic and ask before doing the exercises.';
        }
        show(stop, 'Stop. This needs to be checked with a person before you continue.');
      });
    }

    root.querySelector<HTMLButtonElement>('[data-gate-clear]')?.addEventListener('click', () => {
      show(chooser, 'Safety check passed. Choose the body area your physiotherapist pointed to.');
    });

    root.querySelector<HTMLButtonElement>('[data-stop-back]')?.addEventListener('click', () => {
      show(gate, 'Back to the safety check.');
    });

    // ── Front / back toggle ────────────────────────────────────────────
    const maps = root.querySelectorAll<SVGElement>('[data-map-view]');
    for (const button of root.querySelectorAll<HTMLButtonElement>('[data-view]')) {
      button.addEventListener('click', () => {
        const view = button.dataset.view;
        for (const other of root.querySelectorAll<HTMLButtonElement>('[data-view]')) {
          const active = other === button;
          other.classList.toggle('is-active', active);
          other.setAttribute('aria-pressed', active ? 'true' : 'false');
        }
        for (const map of maps)
          map.toggleAttribute('hidden', map.getAttribute('data-map-view') !== view);
        live.textContent = `${view === 'front' ? 'Front' : 'Back'} view.`;
      });
    }

    // Highlight the matching map shape when the list is hovered or focused, so
    // the two halves of the chooser teach each other.
    for (const link of root.querySelectorAll<HTMLAnchorElement>('[data-area-link]')) {
      const id = link.dataset.areaLink;
      const name =
        link.querySelector<HTMLElement>('.area-name')?.textContent?.trim() ?? 'Body area';
      const paint = (on: boolean) => {
        for (const spot of root.querySelectorAll<SVGElement>(`[data-region="${id}"]`)) {
          spot.classList.toggle('is-active', on);
        }
      };
      link.addEventListener('mouseenter', () => paint(true));
      link.addEventListener('mouseleave', () => paint(false));
      link.addEventListener('focus', () => paint(true));
      link.addEventListener('blur', () => paint(false));
      link.addEventListener('focus', () => {
        live.textContent = `${name} selected. Press Enter to open.`;
      });
      link.addEventListener('keydown', (event) => {
        if (event.key === ' ') {
          event.preventDefault();
          live.textContent = `${name} selected.`;
          link.click();
        }
      });
    }
  }
</script>
