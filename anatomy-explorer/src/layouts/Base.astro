---
/**
 * Base layout — MODULES.md M06.
 *
 * Two deliberate changes from the earlier version:
 *
 * 1. `<ClientRouter />` was removed. It ships a client-side router and animates
 *    page transitions, against PRD §10 ("JS shipped: near zero on content
 *    pages") and DESIGN-SYSTEM's "Motion: almost none · no page transitions".
 *    Patients open two or three pages on a phone that may be old and on a slow
 *    connection; a router costs more than it saves.
 *
 * 2. The skip link is now the first element in the body. It previously sat after
 *    the disclaimer and the top bar, so a keyboard or switch user had to tab
 *    through a dismiss button and the text-size control before reaching the link
 *    whose entire job is to come first.
 */
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/motion.css';
import TopBar from '../components/TopBar.astro';
import Disclaimer from '../components/Disclaimer.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HandbookSearch from '../components/HandbookSearch.astro';
import ShareModal from '../components/ShareModal.astro';

interface Props {
  title: string;
  description?: string;
  lang?: string;
  /**
   * Absolute or root-relative social card. Pages pass their area card
   * (`/social/area-neck.png`) so a link pasted into WhatsApp shows the body
   * area, not a generic banner — which is the difference between a patient
   * recognising their own programme and wondering what was sent to them.
   */
  ogImage?: string;
}

const {
  title,
  description = 'Home exercise and stretching instructions from your physiotherapist.',
  lang = 'en',
  ogImage = '/social/default.png',
} = Astro.props;

/** Canonical URL for this page, with or without a configured `site`. */
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : Astro.url.href;
const socialImage = Astro.site ? new URL(ogImage, Astro.site).href : ogImage;
const isPreview = Astro.url.pathname.startsWith('/preview');
---

<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={isPreview ? 'noindex, nofollow' : 'index, follow'} />

    <!--
      Open Graph + Twitter card. There is no third-party request anywhere in this
      head — deliberately. Under the UAE PDPL an IP address is personal data, and
      a patient looking up a shoulder stretch should not generate a record with
      anyone but the clinic (non-negotiable #6). The card image is generated
      locally by `npm run images:render` from the same geometry as the body map.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Physiotherapy · Patient Library" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Illustrated body figure for ${title}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#0ea5e9" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        const s = localStorage.getItem('physio-scale');
        if (s === '1' || s === '1.15' || s === '1.3') {
          document.documentElement.style.setProperty('--scale', s);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Disclaimer />
    <TopBar />
    <main id="main-content" class="wrap">
      <slot />
    </main>
    <SiteFooter />
    <HandbookSearch />
    <ShareModal />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: -60px;
    inset-inline-start: 0;
    z-index: 100;
    background: var(--ink);
    color: var(--ground);
    padding: 12px 18px;
    min-height: 44px;
    display: flex;
    align-items: center;
    text-decoration: none;
    font-family: var(--f-display);
    font-weight: 600;
    font-size: calc(var(--fs-small) * var(--scale));
    transition: top 0.15s ease;
  }

  .skip-link:focus {
    top: 0;
  }

  .wrap {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 var(--pad) 24px;
  }
</style>
