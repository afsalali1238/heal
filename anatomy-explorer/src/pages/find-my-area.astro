---
/**
 * The locator route. A-014 makes this the canonical entrance;
 * `/find-my-pain/` redirects here.
 */
import Base from '../layouts/Base.astro';
import BackLink from '../components/BackLink.astro';
import AnatomyLocator from '../components/AnatomyLocator.astro';
---

<Base
  title="Find a body area | Physiotherapy"
  description="Choose the body area your physiotherapist pointed to, from a body map or a plain list."
>
  <BackLink href="/" label="Home" />
  {/*
    Patient route carries the 2D chooser only. The 3D body guide
    (FullBodyLocator) stays available on the clinician preview route, but it
    is a prototype blockout — unapproved colours, neck/shoulders only, and a
    second competing map on the same page — so it does not ship to patients.
    Restore it here when a clinician-approved full-body asset lands (sheet +
    asset-registry change, not a code change here).
  */}
  <AnatomyLocator />
</Base>
