---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BackLink from '../../components/BackLink.astro';
import ExerciseImage from '../../components/ExerciseImage.astro';
import MovementGuide from '../../components/exercise/MovementGuide.astro';
import RegionFigure from '../../components/anatomy/RegionFigure.astro';
import RedFlags from '../../components/RedFlags.astro';
import { SECTION_COPY, sectionPath, isSection, itemCountLabel } from '../../lib/section';

export async function getStaticPaths() {
  const [allAreas, allItems] = await Promise.all([getCollection('areas'), getCollection('items')]);
  // Only areas that carry at least one published item get a page. A published
  // area with nothing in it would otherwise render an empty page that the
  // section index links to — the dead end A-005 was written after.
  const populated = new Set(
    allItems
      .filter((item) => item.data.status === 'published')
      .map((item) => `${item.data.section}/${item.data.area_id}`)
  );
  return allAreas
    .filter((area) => area.data.status === 'published')
    .filter((area) => populated.has(`${area.data.section}/${area.data.area_id}`))
    .map((area) => ({
      params: { section: area.data.section, area_id: area.data.area_id },
      props: { area: area.data },
    }));
}

const { section: rawSection, area_id } = Astro.params;
if (!isSection(rawSection)) throw new Error(`Unknown section: ${rawSection}`);
const section = rawSection;
const copy = SECTION_COPY[section];
const { area } = Astro.props;

const allItems = await getCollection('items');
const items = allItems
  .filter(
    (item) =>
      item.data.section === section &&
      item.data.area_id === area_id &&
      item.data.status === 'published'
  )
  .sort((a, b) => a.data.order - b.data.order);

const pageTitle = `${area.name_en} ${copy.shortLabel}`;
---

<Base
  title={`${pageTitle} | Physiotherapy`}
  description={`${area.name_en} ${copy.shortLabel.toLowerCase()} instructions for home, as your physiotherapist prescribed them.`}
  ogImage={`/social/area-${area_id}.png`}
>
  <BackLink href={sectionPath(section)} label={`Back to ${copy.shortLabel}`} />

  <div class="hero">
    <div class="hero-top">
      <div class="hero-title">
        <h1>{area.name_en}</h1>
        <p>
          {itemCountLabel(section, items.length)} · follow only what your physiotherapist went through
          with you.
        </p>
      </div>
      <button
        type="button"
        class="btn-share-page"
        data-share-name={`${area.name_en} ${copy.shortLabel}`}
        aria-label="Share this program"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
        <span>Share Area</span>
      </button>
    </div>

    <div class="hero-figure">
      <RegionFigure areaId={area_id} zoom label={`${area.name_en} area — where to look`} />
    </div>
  </div>

  <RedFlags />

  <div class="starthere">
    <b>Start slowly</b> — perform only the movements your physiotherapist reviewed with you.
  </div>

  <div class="items">
    {
      items.map((item, index) => (
        <article class="item" id={item.data.id} tabindex="-1" data-reveal={Math.min(index, 3)}>
          <div class={`figure ${item.data.type || ''}`}>
            <ExerciseImage
              imageId={item.data.image_id}
              alt={item.data.image_alt_en}
              imageStatus={item.data.image_status}
              eager={index === 0}
            />
          </div>

          <div class="ibody">
            <header class="ihead">
              <span class="inum">{String(index + 1).padStart(2, '0')}</span>
              {item.data.type && (
                <span class={`chip ${item.data.type}`}>{item.data.type.replace(/-/g, ' ')}</span>
              )}
              <h3>{item.data.name_en}</h3>
              <button
                type="button"
                class="btn-item-share"
                data-share-name={item.data.name_en}
                data-item-id={item.data.id}
                aria-label={`Share ${item.data.name_en}`}
                title="Share link & QR code"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="18" cy="5" r="3" />
                  <circle cx="6" cy="12" r="3" />
                  <circle cx="18" cy="19" r="3" />
                  <line x1="8.59" y1="13.51" x2="15.42" y2="17.49" />
                  <line x1="15.41" y1="6.51" x2="8.59" y2="10.49" />
                </svg>
              </button>
            </header>

            <dl class="dose">
              {item.data.hold_seconds && (
                <div>
                  <dt>Hold</dt>
                  <dd>
                    {item.data.hold_seconds} <small>sec</small>
                  </dd>
                </div>
              )}
              {item.data.reps && (
                <div>
                  <dt>Repeat</dt>
                  <dd>
                    {item.data.reps} <small>times</small>
                  </dd>
                </div>
              )}
              {item.data.sets && (
                <div>
                  <dt>Sets</dt>
                  <dd>{item.data.sets}</dd>
                </div>
              )}
              {(item.data.each_side || item.data.frequency_en) && (
                <div>
                  <dt>{item.data.each_side ? 'Each side' : 'Freq'}</dt>
                  <dd style="font-size: 15px; padding-top: 2px;">
                    {item.data.each_side ? 'Yes' : ''}
                    {item.data.each_side && item.data.frequency_en ? ' · ' : ''}
                    {item.data.frequency_en}
                  </dd>
                </div>
              )}
            </dl>

            <MovementGuide item={item.data} />
            {item.data.target_muscles_en && (
              <p class="muscles">
                <b>Target:</b> {item.data.target_muscles_en}
              </p>
            )}

            {item.data.safety_en && (
              <div class="safety">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
                  <path d="M12 9v4" />
                  <path d="M12 17h.01" />
                </svg>
                <span>{item.data.safety_en}</span>
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</Base>

<style>
  /* hero */
  .hero {
    padding: 8px 0 4px;
  }
  .hero {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 16px;
    align-items: start;
  }
  @media (max-width: 560px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero-figure {
      justify-self: start;
    }
  }
  .hero-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .hero-title p {
    margin: 0;
    color: var(--ink-2);
    max-width: 56ch;
    font-size: calc(17px * var(--scale));
  }
  .hero h1 {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: calc(clamp(28px, 7.5vw, 40px) * var(--scale));
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
    text-wrap: balance;
  }
  .hero p {
    margin: 0;
    color: var(--ink-2);
    max-width: 56ch;
    font-size: calc(17px * var(--scale));
  }

  .btn-share-page {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: calc(13px * var(--scale));
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--ink);
    padding: 6px 12px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    min-height: 44px;
  }
  .btn-share-page:hover {
    border-color: var(--brand);
    color: var(--brand);
  }
  .btn-share-page svg {
    width: 15px;
    height: 15px;
  }

  /* start-here banner */
  .starthere {
    margin: 22px 0 4px;
    padding: 14px 17px;
    border-radius: 12px;
    background: var(--strengthen-bg);
    color: var(--strengthen);
    font-size: calc(15.5px * var(--scale));
    line-height: 1.45;
  }
  .starthere b {
    font-family: var(--f-display);
    font-weight: 700;
  }

  /* item card */
  .items {
    display: grid;
    gap: 16px;
    margin-top: 16px;
  }
  .item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r, 14px);
    overflow: hidden;
    scroll-margin-top: 75px;
    transition:
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }
  .item:target,
  .item.is-targeted {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px var(--brand);
  }
  .figure {
    position: relative;
    background: var(--slot);
    border-bottom: 1px solid var(--line);
    aspect-ratio: 4/3;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  /* A robust figure style for child images */
  .figure :global(.exercise-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
  }

  .ibody {
    padding: 17px 19px 20px;
    display: grid;
    gap: 13px;
  }

  .ihead {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
  }
  .inum {
    font-family: var(--f-mono);
    font-size: calc(12.5px * var(--scale));
    font-weight: 600;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .chip {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: calc(11px * var(--scale));
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .chip.mobility {
    background: var(--mobility-bg);
    color: var(--mobility);
  }
  .chip.activation {
    background: var(--mobility-bg);
    color: var(--mobility);
  }
  .chip.stretch {
    background: var(--stretch-bg);
    color: var(--stretch);
  }
  .chip.strengthening {
    background: var(--strengthen-bg);
    color: var(--strengthen);
  }

  .item h3 {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: calc(21px * var(--scale));
    margin: 0;
    line-height: 1.18;
    letter-spacing: -0.012em;
    text-wrap: balance;
    flex: 1;
    min-width: 160px;
  }

  .btn-item-share {
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-3);
    cursor: pointer;
    padding: 0;
    margin-inline-start: auto;
  }
  .btn-item-share:hover {
    background: var(--surface-2);
    color: var(--brand);
    border-color: var(--brand);
  }
  .btn-item-share svg {
    width: 16px;
    height: 16px;
  }

  /* dosage block */
  .dose {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 11px;
    overflow: hidden;
    margin: 0;
  }
  .dose div {
    flex: 1 1 100px;
    background: var(--surface-2);
    padding: 10px 12px;
  }
  .dose dt {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: calc(10px * var(--scale));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 2px;
  }
  .dose dd {
    margin: 0;
    font-family: var(--f-mono);
    font-weight: 600;
    font-size: calc(17px * var(--scale));
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    line-height: 1.2;
  }
  .dose dd small {
    font-family: var(--f-body);
    font-weight: 600;
    font-size: calc(12.5px * var(--scale));
    color: var(--ink-2);
  }

  /* hero: title left, figure right — the figure is orientation, not instruction */
  .hero-title {
    display: grid;
    gap: 6px;
    min-width: 0;
  }
  .hero-figure {
    inline-size: clamp(74px, 22vw, 116px);
    block-size: clamp(120px, 30vw, 170px);
    flex: none;
    border: 1px solid var(--line);
    border-radius: var(--r-inner, 11px);
    background: var(--surface);
    padding: 8px 6px;
    display: grid;
    place-items: center;
  }
  .hero-figure :global(.figure) {
    block-size: 100%;
  }

  .muscles {
    font-size: calc(15.5px * var(--scale));
    color: var(--ink-2);
    margin: 0;
    padding-top: 11px;
    border-top: 1px solid var(--line);
  }
  .muscles b {
    color: var(--ink);
    font-weight: 600;
  }
  .safety {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    align-items: start;
    background: var(--warn-bg);
    color: var(--warn);
    border-radius: 10px;
    padding: 11px 13px;
    margin: 0;
    font-size: calc(15px * var(--scale));
    line-height: 1.45;
  }
  .safety svg {
    width: 18px;
    height: 18px;
    flex: none;
    margin-top: 2px;
  }
</style>

<script>
  (function () {
    // Share handlers
    document.querySelector('.btn-share-page')?.addEventListener('click', (e) => {
      const btn = e.currentTarget as HTMLElement;
      const name = btn.getAttribute('data-share-name') || document.title;
      window.dispatchEvent(
        new CustomEvent('open-share-modal', {
          detail: { name, url: window.location.href.split('#')[0] },
        })
      );
    });

    document.querySelectorAll('.btn-item-share').forEach((btn) => {
      btn.addEventListener('click', () => {
        const name = btn.getAttribute('data-share-name') || '';
        const itemId = btn.getAttribute('data-item-id') || '';
        const baseUrl = window.location.href.split('#')[0];
        const directUrl = `${baseUrl}#${itemId}`;
        window.dispatchEvent(
          new CustomEvent('open-share-modal', {
            detail: { name, url: directUrl },
          })
        );
      });
    });

    // Deep-link anchor focus & scroll handling
    function handleAnchor() {
      const hash = window.location.hash;
      if (!hash) return;
      const target = document.querySelector(hash) as HTMLElement | null;
      if (target) {
        document
          .querySelectorAll('.item.is-targeted')
          .forEach((el) => el.classList.remove('is-targeted'));
        target.classList.add('is-targeted');
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        target.focus({ preventScroll: true });
      }
    }

    if (window.location.hash) {
      setTimeout(handleAnchor, 100);
    }
    window.addEventListener('hashchange', handleAnchor);
  })();
</script>
