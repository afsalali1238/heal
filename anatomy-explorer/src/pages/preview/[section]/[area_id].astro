---
export const prerender = false;
import Base from '../../../layouts/Base.astro';
import BackLink from '../../../components/BackLink.astro';
import ExerciseImage from '../../../components/ExerciseImage.astro';
import { getCollection } from 'astro:content';
import { getPreviewData } from '../../../lib/sheets';
import type { Area } from '../../../lib/types';

const { section, area_id } = Astro.params;

const sheetId = process.env.SHEET_ID;
let area: Area | undefined;
let items: any[] = [];
let errorMsg = '';
let sourceLabel = 'validated local snapshot';

if (sheetId) {
  try {
    const { areas, items: allItems } = await getPreviewData(sheetId);
    area = areas.find((a: Area) => a.section === section && a.area_id === area_id);
    if (area) {
      items = allItems
        .filter((item: any) => item.section === section && item.area_id === area_id)
        .sort((a: any, b: any) => a.order - b.order);
    }
    sourceLabel = 'clinician Google Sheet';
  } catch (err: any) {
    errorMsg = err.message || 'Failed to fetch preview data from Google Sheets.';
  }
} else {
  const [localAreas, localItems] = await Promise.all([
    getCollection('areas'),
    getCollection('items'),
  ]);
  area = localAreas
    .map((entry) => entry.data)
    .find(
      (candidate) =>
        candidate.status !== 'retired' &&
        candidate.section === section &&
        candidate.area_id === area_id
    ) as Area | undefined;
  items = localItems
    .map((entry) => entry.data)
    .filter(
      (item) => item.status !== 'retired' && item.section === section && item.area_id === area_id
    )
    .sort((a, b) => a.order - b.order);
}

const pageTitle = area
  ? `[PREVIEW] ${area.name_en} ${section === 'stretching' ? 'Stretches' : 'Exercises'}`
  : '[PREVIEW] Area Preview';
---

<Base title={`${pageTitle} | Physiotherapy`}>
  <div class="preview-banner">PREVIEW MODE — DO NOT SHARE WITH PATIENTS</div>

  <BackLink href="/preview" label="Back to Preview Index" />

  {!sheetId && <div class="source-notice">Reviewing content from the {sourceLabel}.</div>}

  {
    !area ? (
      <div class="setup-notice">
        <h2>Area Not Found</h2>
        <p>{errorMsg || `The area "${area_id}" was not found in the Google Sheet.`}</p>
      </div>
    ) : (
      <>
        <div class="hero">
          <h1>
            {area.name_en} {area.status === 'draft' ? '(Draft)' : ''}
          </h1>
          <p>Follow these instructions carefully. Stop if you feel pain.</p>
        </div>

        <div class="items">
          {items.map((item: any, index: number) => (
            <article class={`item ${item.status === 'draft' ? 'draft-item' : ''}`} id={item.id}>
              {item.status === 'draft' && <div class="draft-badge">DRAFT</div>}
              <div class={`figure ${item.type || ''}`}>
                <ExerciseImage
                  imageId={item.image_id}
                  alt={item.image_alt_en}
                  imageStatus={item.image_status}
                  eager={index === 0}
                  preview
                />
              </div>

              <div class="ibody">
                <header class="ihead">
                  <span class="inum">{String(index + 1).padStart(2, '0')}</span>
                  {item.type && (
                    <span class={`chip ${item.type}`}>{item.type.replace(/-/g, ' ')}</span>
                  )}
                  <h3>{item.name_en}</h3>
                </header>

                <dl class="dose">
                  {item.hold_seconds && (
                    <div>
                      <dt>Hold</dt>
                      <dd>
                        {item.hold_seconds} <small>sec</small>
                      </dd>
                    </div>
                  )}
                  {item.reps && (
                    <div>
                      <dt>Repeat</dt>
                      <dd>
                        {item.reps} <small>times</small>
                      </dd>
                    </div>
                  )}
                  {item.sets && (
                    <div>
                      <dt>Sets</dt>
                      <dd>{item.sets}</dd>
                    </div>
                  )}
                  {(item.each_side || item.frequency_en) && (
                    <div>
                      <dt>{item.each_side ? 'Each side' : 'Freq'}</dt>
                      <dd style="font-size: 15px; padding-top: 2px;">
                        {item.each_side ? 'Yes' : ''}
                        {item.each_side && item.frequency_en ? ' · ' : ''}
                        {item.frequency_en}
                      </dd>
                    </div>
                  )}
                </dl>

                <dl class="steps">
                  {item.start_position_en && (
                    <div class="step">
                      <dt>Start</dt>
                      <dd>{item.start_position_en}</dd>
                    </div>
                  )}
                  {item.movement_en && (
                    <div class="step">
                      <dt>Move</dt>
                      <dd>{item.movement_en}</dd>
                    </div>
                  )}
                  {item.direction_en && (
                    <div class="step">
                      <dt>Direction</dt>
                      <dd>{item.direction_en}</dd>
                    </div>
                  )}
                  {item.return_en && (
                    <div class="step">
                      <dt>Return</dt>
                      <dd>{item.return_en}</dd>
                    </div>
                  )}
                </dl>

                {item.target_muscles_en && (
                  <p class="muscles">
                    <b>Target:</b> {item.target_muscles_en}
                  </p>
                )}

                {item.safety_en && (
                  <div class="safety">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z" />
                      <path d="M12 9v4" />
                      <path d="M12 17h.01" />
                    </svg>
                    <span>{item.safety_en}</span>
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </>
    )
  }
</Base>

<style>
  .preview-banner {
    background: #dc2626;
    color: white;
    text-align: center;
    font-weight: 700;
    font-size: 14px;
    padding: 8px;
    letter-spacing: 0.05em;
  }
  .setup-notice {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 24px;
    margin: 20px 0;
  }
  .setup-notice h2 {
    font-family: var(--f-display);
    font-size: calc(20px * var(--scale));
    margin: 0 0 10px;
    color: var(--ink);
  }
  .setup-notice p {
    font-size: calc(15.5px * var(--scale));
    color: var(--ink-2);
    margin: 0 0 10px;
    line-height: 1.5;
  }
  .setup-notice code {
    font-family: var(--f-mono);
    background: var(--surface-2);
    padding: 2px 6px;
    border-radius: 4px;
  }
  .source-notice {
    margin: 16px 0;
    padding: 12px 14px;
    border-inline-start: 4px solid var(--brand);
    background: var(--surface-2);
    color: var(--ink-2);
    font-size: calc(15px * var(--scale));
  }
  .draft-item {
    border: 2px dashed #f59e0b;
    position: relative;
  }
  .draft-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 10;
    background: #f59e0b;
    color: #fff;
    padding: 4px 8px;
    font-weight: 700;
    font-size: 12px;
    border-radius: 4px;
  }
  /* hero */
  .hero {
    padding: 8px 0 4px;
  }
  .hero h1 {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: calc(clamp(28px, 7.5vw, 40px) * var(--scale));
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
    text-wrap: balance;
  }
  .hero p {
    margin: 0;
    color: var(--ink-2);
    max-width: 56ch;
    font-size: calc(17px * var(--scale));
  }

  /* item card */
  .items {
    display: grid;
    gap: 16px;
    margin-top: 16px;
  }
  .item {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r, 14px);
    overflow: hidden;
    scroll-margin-top: 70px;
  }
  .figure {
    position: relative;
    background: var(--slot);
    border-bottom: 1px solid var(--line);
    aspect-ratio: 4/3;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .figure :global(.exercise-image) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border-radius: 0;
  }

  .ibody {
    padding: 17px 19px 20px;
    display: grid;
    gap: 13px;
  }

  .ihead {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-wrap: wrap;
  }
  .inum {
    font-family: var(--f-mono);
    font-size: calc(12.5px * var(--scale));
    font-weight: 600;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
  }
  .chip {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: calc(11px * var(--scale));
    letter-spacing: 0.09em;
    text-transform: uppercase;
    padding: 3px 9px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .chip.mobility {
    background: var(--mobility-bg);
    color: var(--mobility);
  }
  .chip.activation {
    background: var(--mobility-bg);
    color: var(--mobility);
  }
  .chip.stretch {
    background: var(--stretch-bg);
    color: var(--stretch);
  }
  .chip.strengthening {
    background: var(--strengthen-bg);
    color: var(--strengthen);
  }

  .item h3 {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: calc(21px * var(--scale));
    margin: 0;
    line-height: 1.18;
    letter-spacing: -0.012em;
    text-wrap: balance;
  }

  /* dosage block */
  .dose {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: 11px;
    overflow: hidden;
    margin: 0;
  }
  .dose div {
    flex: 1 1 100px;
    background: var(--surface-2);
    padding: 10px 12px;
  }
  .dose dt {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: calc(10px * var(--scale));
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 2px;
  }
  .dose dd {
    margin: 0;
    font-family: var(--f-mono);
    font-weight: 600;
    font-size: calc(17px * var(--scale));
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    line-height: 1.2;
  }
  .dose dd small {
    font-family: var(--f-body);
    font-weight: 600;
    font-size: calc(12.5px * var(--scale));
    color: var(--ink-2);
  }

  /* steps */
  .steps {
    display: grid;
    gap: 9px;
    margin: 0;
  }
  .step {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 11px;
    align-items: baseline;
  }
  .step dt {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: calc(10.5px * var(--scale));
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--ink-3);
    width: 74px;
    flex: none;
    padding-top: 2px;
  }
  .step dd {
    margin: 0;
    font-size: calc(16.5px * var(--scale));
    color: var(--ink);
    line-height: 1.45;
  }

  .muscles {
    font-size: calc(15.5px * var(--scale));
    color: var(--ink-2);
    margin: 0;
    padding-top: 11px;
    border-top: 1px solid var(--line);
  }
  .muscles b {
    color: var(--ink);
    font-weight: 600;
  }
  .safety {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    align-items: start;
    background: var(--warn-bg);
    color: var(--warn);
    border-radius: 10px;
    padding: 11px 13px;
    margin: 0;
    font-size: calc(15px * var(--scale));
    line-height: 1.45;
  }
  .safety svg {
    width: 18px;
    height: 18px;
    flex: none;
    margin-top: 2px;
  }
</style>
