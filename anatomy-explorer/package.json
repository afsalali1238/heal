{
  "name": "anatomy-explorer",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "npm run check:all",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check --minimumSeverity error",
    "check:compliance": "tsx scripts/check-compliance.ts",
    "check:anatomy": "tsx scripts/check-anatomy.ts",
    "check:images": "tsx scripts/check-images.ts",
    "check:assets": "tsx scripts/check-assets.ts",
    "check:poses": "tsx scripts/check-poses.ts",
    "test:gates": "tsx --test \"tests/**/*.test.ts\"",
    "check:all": "npm run check:compliance && npm run check:anatomy && npm run check:poses && npm run check:images && npm run check:assets && npm run test:gates",
    "sync:content": "tsx scripts/sync-content.ts",
    "qr": "tsx scripts/generate-qr.ts",
    "astro": "astro",
    "figures:render": "tsx scripts/render-poses.ts",
    "lint": "prettier --check \"src/**/*.{astro,ts,css,json}\" \"scripts/**/*.ts\" \"*.md\"",
    "format": "prettier --write \"src/**/*.{astro,ts,css,json}\" \"scripts/**/*.ts\"",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "images:render": "tsx scripts/render-share-images.ts",
    "images:items": "tsx scripts/render-item-figures.ts",
    "images:movement": "tsx scripts/render-movement-figures.ts",
    "images:movement:manifest": "tsx scripts/check-poses.ts --write",
    "crawl": "tsx scripts/crawl-routes.ts"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.7",
    "@types/three": "^0.185.4",
    "astro": "^7.2.4",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/papaparse": "^5.5.2",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^17.4.2",
    "papaparse": "^5.6.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3"
  }
}
