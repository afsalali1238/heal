{
  "semi": true,
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "es5",
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro"
      }
    },
    {
      "files": [
        "*.md"
      ],
      "options": {
        "proseWrap": "preserve"
      }
    }
  ],
  "plugins": [
    "prettier-plugin-astro"
  ]
}
